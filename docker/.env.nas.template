# BookmarkFeeder — NAS docker compose deployment
#
# Copy this to .env ON THE NAS and fill it in ONCE. It is the deployment's source of truth and is
# never overwritten: `aspire publish` only ever adds missing KEYS, so regenerating the compose
# leaves these values alone.
#
#   cp .env.nas.template .env
#   chmod 600 .env            # it holds real secrets
#   docker compose up -d
#
# Between releases only the three *_IMAGE tags change — ./scripts/docker-release.* prints the
# exact lines to paste.

# ── Identity — not secrets, but you must fill them in. ─────────────────────────────────────────
# Auth0 provides sign-in for the web app. A tenant domain, an API audience and a public SPA client
# id are all published in any browser bundle, so none of these need protecting - but they are
# per-tenant, and the app cannot start without them.
#
# docs/deployment.md has the two `auth0` CLI commands that create the API and the SPA application.
# Remember to list your https://<machine>.<tailnet>.ts.net URL in the application's Allowed
# Callback URLs, Allowed Logout URLs and Allowed Web Origins.
#
# The browser extension does NOT use Auth0: you sign in to the web app and mint it an API key.
AUTH0_DOMAIN=CHANGE-ME.eu.auth0.com
AUTH0_AUDIENCE=https://api.bookmarkfeeder
AUTH0_CLIENT_ID=CHANGE-ME-spa-client-id

# Only if you are UPGRADING an install from before accounts existed (before 0.2.0): the Auth0 subject
# (e.g. google-oauth2|1234...) or email of the person who should get the bookmarks that were
# already there. Signup is open, so the collection is never simply handed to whoever signs in
# first. Your subject is shown in the web app under Settings. Leave empty on a fresh install.
AUTH0_LEGACY_OWNER=

# ── Secrets — replace this one. ────────────────────────────────────────────────────────────────
# Postgres password. Only reachable inside the compose network, but generate a real one anyway.
# Pick it ONCE: the database volume keeps the password from first boot, so changing this later
# locks the API out of its own data until you reset the volume.
#   openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE-ME-generate-a-long-random-string

# ── Where the database lives ───────────────────────────────────────────────────────────────────
# Postgres writes its cluster to a BIND MOUNT — a real directory on the NAS, not Docker's internal
# volume store (/volume1/@docker/volumes/...), which File Station cannot see and Hyper Backup does
# not treat as a shared folder. This way the data is visible, snapshottable and backed up with
# everything else in the folder.
#
# Leave it unset and it defaults to ./data/postgres, relative to the compose file — so dropping
# docker-compose.yaml in /volume1/docker/bookmarkfeeder/ puts the cluster in
# /volume1/docker/bookmarkfeeder/data/postgres. Set it to put the data on another volume.
#
# The directory is created on first start; the postgres image fixes its ownership itself.
# This is the ONLY directory that matters for backup — everything else is rebuildable from images.
#POSTGRES_DATA_PATH=/volume1/docker/bookmarkfeeder/data/postgres

# ── Ports ──────────────────────────────────────────────────────────────────────────────────────
# The gateway is the only service that publishes a port at all - webapi, web and postgres stay
# internal. It publishes on LOOPBACK ONLY (127.0.0.1), so nothing on your LAN or tailnet can reach
# it directly; the TLS terminator in front is the sole way in.
#
# TLS IS REQUIRED. Signing in uses PKCE, which needs the browser's Web Crypto API, and browsers
# expose that only on secure origins - a plain http:// address cannot log in, whatever the port.
# `tailscale serve` supplies a real Let's Encrypt certificate and a stable hostname:
#
#   tailscale serve --bg --https=443 http://127.0.0.1:8081     # browse https://<machine>.<tailnet>.ts.net
#
# If 443 on that host already belongs to something else, terminate on this port number instead:
#
#   tailscale serve --bg --https=8081 http://127.0.0.1:8081    # browse https://<machine>.<tailnet>.ts.net:8081
#
# There is no conflict in the second form: the container is bound to 127.0.0.1 and tailscale
# listens on the tailnet address. Both would try to own the port if the container published on
# 0.0.0.0, which is exactly why it does not.
#
# Whichever you pick, register that EXACT origin in Auth0 - a port makes it a different origin, so
# https://host and https://host:8081 are not interchangeable in the callback and web-origin lists.
#
# 8081 rather than 8080, which is already taken (Glance); DSM itself uses 5000/5001.
GATEWAY_PORT=8081

# Which host address the gateway publishes on. Loopback by default, per the note above. Set it to
# 0.0.0.0 only when the TLS terminator runs on a DIFFERENT machine and has to reach this one over
# the network - it puts a plain-HTTP copy of the app on every interface, and that origin cannot
# sign in.
#GATEWAY_BIND=0.0.0.0

# The telemetry dashboard (:18888) likewise publishes on 127.0.0.1; use an SSH tunnel to view it.
#DASHBOARD_BIND=0.0.0.0

# The API's port INSIDE its own container. Never published, so it cannot collide with anything on
# the host — 8080 here is unrelated to the gateway's published port and needs no change.
WEBAPI_PORT=8080

# ── Images ─────────────────────────────────────────────────────────────────────────────────────
# Deploy by VERSION TAG, never :latest — otherwise "which build is running?" has no answer and a
# restart can silently change the app. ./scripts/docker-release.* prints these after a push.
WEBAPI_IMAGE=docker.io/mgpeter/bookmarkfeeder-webapi:0.3.16
GATEWAY_IMAGE=docker.io/mgpeter/bookmarkfeeder-gateway:0.3.16
WEB_IMAGE=docker.io/mgpeter/bookmarkfeeder-web:0.3.16
