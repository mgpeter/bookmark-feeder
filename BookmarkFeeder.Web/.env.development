# Only used by a standalone `npm run dev`. Under the Aspire AppHost these arrive as environment
# variables instead, and in production the nginx entrypoint writes them into config.js.
#
# These are PUBLIC values - an Auth0 SPA client id is not a secret - but they are per-tenant, so
# point them at your own tenant. See docs/deployment.md.
VITE_AUTH0_DOMAIN=usualexpat.uk.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.bookmarkfeeder
